manifest {
	author = "Sergey Abramov, Anas Fathul, Alexandr Boytsov & John Hutchinson"
	mainScript = "main.nf"
	defaultBranch = "master"
	name = "nf-footprinting"
	description = "Footprinting pipeline from chromatin accessbility data"
	version = "0.1"
	nextflowVersion = "22.04.0"
}

process.shell = ['/bin/bash', '-ueo','pipefail' ]

params {
	includeConfig './params.config'
}

profiles {

	//Pan-environment configuration; modify to computing enviroment specifications
	Altius {
		process {
			executor = "slurm"
			queue = "hpcz-test,bigmem"
			memory = { 8.GB * task.attempt }
			cache = "lenient"
			errorStrategy = { (task.exitStatus in 137..143) ? 'retry' : 'ignore' }
			maxRetries = 3
			
			// consensus_footprints.nf: merging hotspots and all samples' posteriors
			withLabel: highmem {
				queue = "bigmem"
				memory = { 800.GB + (task.attempt - 1) * 50.GB }
			}

			withLabel: high_cpu {
				cpus = 8
				errorStrategy = 'ignore'
			}
			withLabel: diff_footprints {
				cpus = 2
				memory = { 8.GB * task.attempt }
			}
			withLabel: diff_report {
				memory = { 32.GB * task.attempt }
			}
		}
        conda.enabled = true
		
		executor {
			$slurm {
				queueSize = 400

			}
		}
	}
}
